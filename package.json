{
  "name": "bidstream",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time auction platform with high-concurrency correctness",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build -w packages/contracts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/web --if-present",
    "test:concurrency": "npm run test:concurrency -w apps/api --if-present",
    "test:load": "node scripts/run-benchmarks.mjs",
    "test:invariants": "node scripts/check-invariants.mjs",
    "test:socket-latency": "node scripts/measure-socket-latency.mjs",
    "test:measure-web": "node scripts/measure-web.mjs",
    "test:verify-readme": "node scripts/verify-readme-metrics.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "prisma:seed": "npm run prisma:seed -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
