# Node Environment
NODE_ENV=development
PORT=3001

# PostgreSQL Database
DATABASE_URL=postgresql://bidstream:bidstream_pass@localhost:5432/bidstream_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (replace with secure keys in production)
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_at_least_32_characters_long
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Frontend Configuration (apps/web)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

