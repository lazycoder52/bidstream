# Node Environment
NODE_ENV=development
PORT=3001

# PostgreSQL Database
DATABASE_URL=postgresql://bidstream:bidstream_pass@localhost:5432/bidstream_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set REDIS_IN_MEMORY=true strictly for local development without Docker (prohibited in production)
REDIS_IN_MEMORY=false

# JWT Secrets (replace with secure keys in production)
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120
THROTTLE_FAIL_OPEN=false

# Frontend Configuration (apps/web)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
